<?xml version="1.0"?>
<package format="3">
  <name>le1000_urdf_t4</name>
  <version>1.0.0</version>
  <description>
    <p>URDF Description package for LE1000-URDF-T4</p>
    <p>This package contains configuration data, 3D models and launch files
for LE1000-URDF-T4 robot</p>
  </description>
  <author>TODO</author>
  <maintainer email="TODO@email.com">TODO</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <!-- loone_asv.urdf.xacro includes $(find zed_wrapper)/urdf/zed_macro.urdf.xacro and
       instantiates the camera as the robot's root link, so the description cannot be
       expanded without the ZED wrapper package on the path. -->
  <exec_depend>zed_wrapper</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>topic_based_ros2_control</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <architecture_independent/>
  </export>
</package>
